{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4-flash",
  "agent": {
    "build": {
      "model": "opencode-go/deepseek-v4-flash",
      "temperature": 0.3,
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },
    "plan": {
      "model": "opencode-go/deepseek-v4-pro",
      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "explore": {
      "model": "opencode-go/deepseek-v4-flash"
    },
    "general": {
      "model": "opencode-go/deepseek-v4-flash"
    },
    "review": {
      "description": "Qt/QML 代码审查：只读审查，绝不改代码；给出结构化问题清单与修复建议（方法论见 .opencode/prompts/review.md）",
      "mode": "all",
      "model": "opencode-go/deepseek-v4-flash",
      "temperature": 0.1,
      "prompt": "{file:./.opencode/prompts/review.md}",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "pwsh -File .opencode/scripts/*": "allow",
          "powershell -File .opencode/scripts/*": "allow",
          "Get-*": "allow",
          "Select-String*": "allow",
          "findstr*": "allow",
          "rg*": "allow",
          "grep*": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git blame*": "allow",
          "git ls-files*": "allow",
          "git branch*": "allow",
          "git grep*": "allow",
          "ctest*": "allow",
          "cmake --build*": "allow",
          "Start-Process*": "allow",
          "Stop-Process*": "allow",
          "Test-Path*": "allow",
          "where*": "allow",
          "*Set-Content*": "deny",
          "*Add-Content*": "deny",
          "*Remove-Item*": "deny",
          "*Move-Item*": "deny",
          "*Copy-Item*": "deny",
          "*New-Item*": "deny",
          "*Out-File*": "deny",
          "*>*": "deny",
          "git add*": "deny",
          "git commit*": "deny",
          "git push*": "deny",
          "git reset*": "deny",
          "git checkout*": "deny",
          "git clean*": "deny",
          "git revert*": "deny",
          "git stash*": "deny",
          "rm *": "deny",
          "del *": "deny",
          "rd *": "deny"
        }
      }
    },
    "doc-writer": {
      "description": "撰写/同步 docs/ 设计文档与 AGENTS.md/HANDOVER.md，保持文档与代码一致",
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-flash",
      "permission": {
        "bash": "deny"
      }
    }
  },
  "mcp": {
    "vision": {
      "type": "local",
      "command": ["node", ".opencode/mcp/vision/server.mjs"],
      "cwd": ".",
      "enabled": true
    }
  }
}
