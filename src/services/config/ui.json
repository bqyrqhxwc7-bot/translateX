{
  "id": "ui",
  "displayName": "界面",
  "settings": [
    {
      "key": "translatePanelMode",
      "displayName": "翻译面板模式",
      "description": "ppt=功能区（Ribbon 翻译标签）；floating=悬浮窗（可自由拖动，位置自动记忆）",
      "type": "enum",
      "options": ["ppt", "floating"],
      "default": "ppt",
      "group": "翻译面板"
    },
    {
      "key": "translatePanelVisible",
      "displayName": "启动时显示翻译面板",
      "description": "floating 模式下打开应用时自动显示悬浮窗",
      "type": "bool",
      "default": false,
      "group": "翻译面板"
    },
    {
      "key": "translatePanelX",
      "displayName": "悬浮窗位置 X（内部）",
      "description": "悬浮窗拖动记忆的横坐标（内部状态，不在设置页显示）",
      "type": "number",
      "default": 16,
      "group": "翻译面板"
    },
    {
      "key": "translatePanelY",
      "displayName": "悬浮窗位置 Y（内部）",
      "description": "悬浮窗拖动记忆的纵坐标（内部状态，不在设置页显示）",
      "type": "number",
      "default": 170,
      "group": "翻译面板"
    },
    {
      "key": "translatePanelWidth",
      "displayName": "悬浮窗宽度（内部）",
      "description": "悬浮窗手动缩放记忆的宽度（内部状态，不在设置页显示）",
      "type": "number",
      "default": 300,
      "group": "翻译面板"
    },
    {
      "key": "translatePanelHeight",
      "displayName": "悬浮窗高度（内部）",
      "description": "悬浮窗手动缩放记忆的高度（内部状态，不在设置页显示）",
      "type": "number",
      "default": 300,
      "group": "翻译面板"
    },
    {
      "key": "currentRibbonTab",
      "displayName": "当前功能区标签（内部）",
      "description": "Ribbon 当前选中的标签索引，NoStack 页面重建后恢复（内部状态）",
      "type": "number",
      "default": 0,
      "group": "翻译面板"
    },
    {
      "key": "originalFontSize",
      "displayName": "原文字号",
      "description": "编辑器原文显示与编辑的字号（像素）",
      "type": "number",
      "default": 14,
      "group": "显示"
    },
    {
      "key": "commentFontSize",
      "displayName": "批注字号",
      "description": "批注（译文）显示与编辑的字号（像素），独立于原文",
      "type": "number",
      "default": 12,
      "group": "显示"
    },
    {
      "key": "findCaseSensitive",
      "displayName": "查找区分大小写",
      "description": "查找/替换是否区分大小写",
      "type": "bool",
      "default": false,
      "group": "查找"
    },
    {
      "key": "findWholeWord",
      "displayName": "查找整词匹配",
      "description": "查找/替换是否整词匹配",
      "type": "bool",
      "default": false,
      "group": "查找"
    },
    {
      "key": "findFuzzy",
      "displayName": "模糊查找",
      "description": "查询字符按顺序出现即匹配（子序列模糊匹配），不要求连续",
      "type": "bool",
      "default": false,
      "group": "查找"
    },
    {
      "key": "autosaveEnabled",
      "displayName": "自动保存",
      "description": "编辑时每 60 秒自动保存到应用数据目录（崩溃后可恢复；受限模式/大文件自动禁用）",
      "type": "bool",
      "default": true,
      "group": "自动保存"
    },
    {
      "key": "leftPanelWidth",
      "displayName": "侧边栏宽度（内部）",
      "description": "分割侧边栏拖拽后的宽度（内部状态，不在设置页显示）",
      "type": "number",
      "default": 240,
      "group": "布局"
    },
    {
      "key": "iconBarVisible",
      "displayName": "图标栏可见（内部）",
      "description": "最左 Outlook 式图标栏收起状态（内部状态）",
      "type": "bool",
      "default": true,
      "group": "布局"
    },
    {
      "key": "sidebarVisible",
      "displayName": "侧边栏可见（内部）",
      "description": "分割侧边栏收起状态（内部状态）",
      "type": "bool",
      "default": true,
      "group": "布局"
    },
    {
      "key": "windowX",
      "displayName": "主窗口位置 X（内部）",
      "description": "主窗口拖动记忆的横坐标（内部状态，不在设置页显示）",
      "type": "number",
      "default": 0,
      "group": "布局"
    },
    {
      "key": "windowY",
      "displayName": "主窗口位置 Y（内部）",
      "description": "主窗口拖动记忆的纵坐标（内部状态，不在设置页显示）",
      "type": "number",
      "default": 0,
      "group": "布局"
    },
    {
      "key": "windowWidth",
      "displayName": "主窗口宽度（内部）",
      "description": "主窗口大小记忆的宽度（内部状态，不在设置页显示）",
      "type": "number",
      "default": 1200,
      "group": "布局"
    },
    {
      "key": "windowHeight",
      "displayName": "主窗口高度（内部）",
      "description": "主窗口大小记忆的高度（内部状态，不在设置页显示）",
      "type": "number",
      "default": 780,
      "group": "布局"
    },
    {
      "key": "windowMaximized",
      "displayName": "主窗口最大化（内部）",
      "description": "主窗口退出时是否处于最大化（内部状态，不在设置页显示）",
      "type": "bool",
      "default": false,
      "group": "布局"
    }
  ]
}

